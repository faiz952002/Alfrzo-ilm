# Copy these into your hosting provider's "Environment variables" screen. Never commit real values.

# --- Required (Supabase > Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=            # the PUBLIC "anon" key (safe for browsers)

# --- Recommended ---
SITE_URL=https://your-domain.com      # used for canonical links and sitemap
CONTACT_EMAIL=                        # shown on the privacy page
TRUST_PROXY=1                         # set to 1 on Render/Railway/any reverse proxy

# --- Audio/video consultation calls open at this address + a private room name (default: https://meet.jit.si/) ---
MEETING_BASE_URL=

# --- Only for paid Premium and paid consultations (leave empty to keep payments OFF) ---
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server only. Never put it in public/js/config.js
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # SECRET
RAZORPAY_WEBHOOK_SECRET=              # SECRET. Webhook URL: https://your-domain.com/api/payments/webhook
PREMIUM_PRICE_PAISE=9900              # 9900 = Rs 99
PREMIUM_DAYS=30
